# Creekside Booking (standalone deployable project) — copy to .env and fill in real values.
# Never commit .env.
#
# Auth is a Google service account with Workspace domain-wide delegation, KEYLESS: no
# private key exists anywhere. The app authenticates as the service account through
# Application Default Credentials (Workload Identity Federation from the EC2 instance role
# in production) and has Google sign the delegation assertion via IAM signJwt.
#
# There is no OAuth consent screen, no app publication, and no per-provider sign-in.
# Setup steps are in DEPLOY.md.

# --- Google service account (keyless) ---------------------------------------
# The service account to impersonate providers as.
CSB_SA_EMAIL=creekside-booking@<project-id>.iam.gserviceaccount.com

# The service account's numeric Unique ID. Display-only: the admin page shows it so whoever
# creates the Workspace delegation entry can copy it. Found on the service account's details
# page in Google Cloud.
CSB_SA_CLIENT_ID=

# Standard ADC variable — absolute path to the Workload Identity Federation credential
# config JSON produced by `gcloud iam workload-identity-pools create-cred-config`.
# NOT a secret: it contains no key material, only pointers to the pool/provider and the AWS
# metadata endpoint. Safe on disk; still keep it out of the repo.
GOOGLE_APPLICATION_CREDENTIALS=/etc/creekside/wif-credentials.json

# Workspace domain every provider address must belong to. A service account cannot
# impersonate accounts outside the delegated domain, so the admin page rejects others.
CSB_WORKSPACE_DOMAIN=creeksidemarketingpros.com

# --- Admin surface ----------------------------------------------------------
# HTTP Basic Auth for /admin/booking and /api/csb/admin/*.
CSB_ADMIN_USER=admin
CSB_ADMIN_PASS=

# Kill switch for the admin surface. Leave unset (or "true") while adding providers and
# configuring hours; set to "false" once setup is finished to take /admin/booking and
# /api/csb/admin/* out of service (404, not 401 — reveals nothing to a prober).
CSB_ADMIN_ENABLED=true

# --- Storage ----------------------------------------------------------------
# sqlite (local dev only) | postgres (Supabase — the production driver)
CSB_DB_DRIVER=sqlite

# Only needed when CSB_DB_DRIVER=postgres. Dedicated Supabase project for this client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- App --------------------------------------------------------------------
# Origin the app is served from. Must be the real domain in production.
CSB_BASE_URL=http://localhost:3000

# --- GoHighLevel CRM sync ---------------------------------------------------
# Both required for funnel lead sync and opportunity stage updates. When unset, the CRM
# integration silently no-ops rather than failing bookings.
GHL_API_KEY=
GHL_LOCATION_ID=
