# Creekside Booking (standalone deployable project) — copy to .env and fill in real values.
# Never commit .env. This project is deployed independently to Vercel; the marketing site
# (one level up) reverse-proxies /book, /admin, /api/csb/* to it once Apache is configured.

# Google Cloud OAuth 2.0 web client (Calendar API v3 enabled). Redirect URI to register
# in Google Cloud (Testing mode, non-sensitive scopes only):
#   http://localhost:3000/api/csb/oauth/callback
CSB_GOOGLE_CLIENT_ID=
CSB_GOOGLE_CLIENT_SECRET=

# Random 32+ byte secret used to derive the AES-256-CBC key that encrypts stored Google
# refresh tokens at rest. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every already-connected account (they'll need to reconnect).
CSB_ENCRYPTION_KEY=

# HTTP Basic Auth for /admin/booking and /api/csb/admin/*.
CSB_ADMIN_USER=admin
CSB_ADMIN_PASS=

# Kill switch for the admin surface. Leave unset (or "true") while connecting accounts and
# configuring hours; set to "false" once setup is finished to take /admin/booking and
# /api/csb/admin/* out of service (404, not 401 — reveals nothing to a prober). Flip back
# to reconnect an account or pull a CSV export later.
CSB_ADMIN_ENABLED=true

# sqlite (local dev only) | postgres (Supabase -- the actual production driver, since
# serverless hosts like Vercel give no persistent local disk for sqlite to write to)
CSB_DB_DRIVER=sqlite

# Only needed when CSB_DB_DRIVER=postgres. Dedicated Supabase project for this client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Origin used to build the OAuth redirect URI. Must match what's registered in Google Cloud.
# In production this MUST be the real domain (https://creeksidemarketingpros.com), not the
# *.vercel.app URL -- Apache proxies transparently so Google never sees the Vercel URL, but
# only if this matches what customers actually see in their browser.
CSB_BASE_URL=http://localhost:3000
