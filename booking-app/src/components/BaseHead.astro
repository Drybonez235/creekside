---
// src/components/BaseHead.astro
interface Props {
  title: string;
  description: string;
  canonicalURL: string;
//   image?: string;
}

const { title, description, canonicalURL,} = Astro.props; //image = '/placeholder-social.avif'

import SeoHead from '../components/SeoHead.astro'
