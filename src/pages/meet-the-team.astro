---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro'
import Layout from '../layouts/Layout.astro';
import { siteSchema } from '../data/structuredData';

import '../styles/global.css';

const teamMembers = [
  {
    firstName: "Peterson",
    lastName: "Rainey",
    image: "/peterson-rainey-headshot.avif",
    role: "Co-owner & Founder",
    bio: "Co-owner of Creekside Marketing and a mechanical engineer by training, Peterson focuses on Google Ads strategy and performance. His technical mindset and data-first approach drive consistent, measurable growth for clients."
  },
  {
    firstName: "Cade",
    lastName: "Maclean",
    image: "/cade-maclean-headshot.avif",
    role: "Co-Owner & Manager",
    bio: "Co-owner of Creekside Marketing with a background in accounting and an MBA, Cade specializes in data-driven Facebook advertising. He brings analytical precision and strategic optimization to help businesses scale profitably."
  },
  {
    firstName: "Baran",
    lastName: "Eris",
    image: "/baran-eris.avif",
    role: "Lead Small Business Consultant",
    bio: "Baran helps businesses generate and convert traffic with scalable ad campaigns. He focuses on building high-converting funnels and making sure every step of the customer journey supports profitable growth. " 
  },

  {
    firstName: "Scott",
    lastName: "Caldwell",
    image: "/scott-caldwell-headshot.avif",
    role: "Small Business Marketing Consultant",
    bio: "Scott is a digital strategist with agency and in-house experience managing multi-channel campaigns and advanced analytics. He's scaled brands across multiple industries through technical tracking and paid media optimization."
  },
  {
    firstName: "Ahmed",
    lastName: "",
    image: "/ahmed-headshot.avif",
    role: "Google Ads Specialist",
    bio: "" 
  },
  {
    firstName: "Ade",
    lastName: "",
    image: "/ade-headshot.avif",
    role: "Google Ads Specialist",
    bio: "" 
  },
  {
    firstName: "Lindsey",
    lastName: "",
    image: "/lindsey-headshot.avif",
    role: "Meta Ads Specialist",
    bio: "" 
  },
  {
    firstName: "Cyndi",
    lastName: "",
    image: "/cyndi-headshot.avif",
    role: "Executive Assistant",
    bio: "" 
  },
  {
    firstName: "David",
    lastName: "",
    image: "/david-caicedo-headshot.avif",
    role: "Meta Ads Specialist",
    bio: ""
  },
    {
    firstName: "Sophia",
    lastName: "Rainey",
    image: "/sophia-rainey-headshot.avif",
    role: "Creatives Director",
    bio: "" 
  },
  {
    firstName: "Trent",
    lastName: "",
    image: "/trent-headshot.avif",
    role: "Meta Ads Specialist",
    bio: "" 
  },
  {
    firstName: "Melvin",
    lastName: "",
    image: "/melvin-headshot.avif",
    role: "Executive Assistant",
    bio: "" 
  },
];

// Role-based fallback bios for team members without a personal bio
const roleBios: Record<string, string> = {
  "Google Ads Specialist": "Manages Google Ads accounts end to end: search strategy, bidding, negative keyword pruning, and weekly optimization. A senior specialist working with a maximum of 10 clients.",
  "Meta Ads Specialist": "Runs Meta campaigns from creative testing to scaling: audience strategy, budget pacing, and conversion tracking. A senior specialist capped at 10 clients.",
  "Creatives Director": "Leads ad creative across every client account: hooks, visuals, and copy built to convert. Every ad Creekside ships passes through her review.",
  "Executive Assistant": "Keeps client operations running smoothly behind the scenes: scheduling, onboarding, and making sure nothing slips between meetings.",
};
const getBio = (member: { bio: string; role: string }) => member.bio || roleBios[member.role] || "";

// Grouping Logic
const leadership = teamMembers.slice(0, 4);
const googleTeam = teamMembers.filter(m => m.role.includes("Google Ads"));
const metaTeam = teamMembers.filter(m => m.role.includes("Meta Ads"));
const supportTeam = teamMembers.filter(m => 
  !leadership.includes(m) && 
  !googleTeam.includes(m) && 
  !metaTeam.includes(m)
);

// Helper to center the 3rd item in a 2-column grid if the total is odd
const getGridItemClass = (index: number, length: number) => {
  const isLast = index === length - 1;
  const isOddTotal = length % 2 !== 0;
  return isLast && isOddTotal ? "md:col-span-2" : "";
};
---

<Layout
  title="Meet The Team - Creekside Marketing" 
  description="Get to know the experts behind your growth. Meet the Creekside Marketing team, a collective of specialized Google Ads, Meta Ads, and digital strategy pros dedicated to scaling your business."
  canonicalURL="https://creeksidemarketingpros.com/meet-the-team/"
  schema={siteSchema.meetTheTeam}
>
  <Nav />

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      
      <header class="mb-20 text-center">
        <h1 class="text-primary-900 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl lg:text-5xl">
          Meet Our Team
        </h1>
        <div class="bg-secondary-500 mx-auto mt-4 h-1.5 w-20 rounded-full"></div>
        <p class="text-grey-700 mx-auto mt-6 max-w-2xl text-lg/8">
          Creekside is boutique by design. Every specialist works with a maximum
          of 10 clients, only senior specialists touch your account, and you get
          one direct channel with the entire team working on it.
        </p>
        <div class="mx-auto mt-8 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-lg border border-grey-200 bg-grey-50 px-4 py-5">
            <p class="text-primary-900 font-bold">Max 10 clients per specialist</p>
          </div>
          <div class="rounded-lg border border-grey-200 bg-grey-50 px-4 py-5">
            <p class="text-primary-900 font-bold">Senior specialists only</p>
          </div>
          <div class="rounded-lg border border-grey-200 bg-grey-50 px-4 py-5">
            <p class="text-primary-900 font-bold">One direct channel with your whole team</p>
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-x-12 gap-y-20 md:grid-cols-2">
        {leadership.map((member, index) => (
          <div class={`flex flex-col items-center text-center ${getGridItemClass(index, leadership.length)}`}>
            <h3 class="text-primary-900 text-2xl font-black uppercase tracking-tighter lg:text-3xl">
              {member.firstName} <span class="text-secondary-500">{member.lastName}</span>
            </h3>
            <div class="my-6 shrink-0">
              <img 
                src={member.image} 
                alt={`${member.firstName} ${member.lastName}`}
                class="size-64 rounded-full object-cover shadow-sm"
                loading="lazy"
              />
            </div>
            <div class="flex flex-col gap-3 max-w-md">
              <h4 class="text-primary-800 text-lg font-bold uppercase tracking-wide">
                {member.role}
              </h4>
              {member.bio && (
                <p class="text-grey-700 text-base/7">
                  {member.bio}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>

      <hr class="border-grey-200 my-24" />

      <div class="mb-16 text-center">
        <h2 class="text-primary-900 mb-4 text-5xl font-extrabold uppercase tracking-tight">Our <span class="text-secondary-500">Google Ads</span> Team</h2>
        <div class="bg-secondary-500 mx-auto h-1 w-12 rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 gap-x-12 gap-y-16 md:grid-cols-2">
        {googleTeam.map((member, index) => (
          <div class={`flex flex-col items-center text-center ${getGridItemClass(index, googleTeam.length)}`}>
            <h3 class="text-secondary-500 text-xl font-bold uppercase mb-2">{member.firstName}</h3>
             <img
                src={member.image}
                alt={member.firstName}
                class="size-48 mb-6 rounded-full object-cover shadow-sm"
                loading="lazy"
              />
            <p class="text-primary-900 font-semibold uppercase tracking-wider">{member.role}</p>
            {getBio(member) && (
              <p class="text-grey-700 mt-3 max-w-md text-base/7">
                {getBio(member)}
              </p>
            )}
          </div>
        ))}
      </div>

      <hr class="border-grey-200 my-24" />

      <div class="mb-16 text-center">
        <h2 class="text-primary-900 mb-4 text-5xl font-extrabold uppercase tracking-tight">Our <span class="text-secondary-500">Meta Ads</span> Team</h2>
        <div class="bg-secondary-500 mx-auto h-1 w-12 rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 gap-x-12 gap-y-16 md:grid-cols-2">
        {metaTeam.map((member, index) => (
          <div class={`flex flex-col items-center text-center ${getGridItemClass(index, metaTeam.length)}`}>
            <h3 class="text-secondary-500 text-xl font-bold uppercase mb-2">{member.firstName}</h3>
             <img
                src={member.image}
                alt={member.firstName}
                class="size-48 mb-6 rounded-full object-cover shadow-sm"
                loading="lazy"
              />
            <p class="text-primary-900 font-semibold uppercase tracking-wider">{member.role}</p>
            {getBio(member) && (
              <p class="text-grey-700 mt-3 max-w-md text-base/7">
                {getBio(member)}
              </p>
            )}
          </div>
        ))}
      </div>

      <hr class="border-grey-200 my-24" />

      <div class="mb-16 text-center">
        <h2 class="text-primary-900 mb-4 text-5xl font-extrabold uppercase tracking-tight">Supporting Your <span class="text-secondary-500">Success</span></h2>
        <div class="bg-secondary-500 mx-auto h-1 w-12 rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 gap-x-12 gap-y-16 md:grid-cols-2">
        {supportTeam.map((member, index) => (
          <div class={`flex flex-col items-center text-center ${getGridItemClass(index, supportTeam.length)}`}>
            <h3 class=" text-secondary-500 text-xl font-bold uppercase mb-2">{member.firstName} {member.lastName}</h3>
             <img
                src={member.image}
                alt={member.firstName}
                class="size-48 mb-6 rounded-full object-cover shadow-sm"
                loading="lazy"
              />
            <p class="text-primary-900 font-semibold uppercase tracking-wider">{member.role}</p>
            {getBio(member) && (
              <p class="text-grey-700 mt-3 max-w-md text-base/7">
                {getBio(member)}
              </p>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <Footer />
</Layout>