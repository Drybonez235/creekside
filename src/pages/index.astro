---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro'
import TestimonialScreenshots from '../components/TestimonialScreenshots.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import GuaranteeBadges from '../components/GuaranteeBadges.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteSchema, faqSchemas } from '../data/structuredData';
import '../styles/global.css';

const featuredDifferentiators = [
  {
    title: "Our Incentives Are Aligned With Yours",
    body: "Our fee is a percentage of your ad spend, and the rate drops as you scale. We don't benefit from inflating your budget. You control the spend, and we only make more money if you're actually making more money. No long-term contracts.",
    iconPath: "M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z",
  },
  {
    title: "You Talk to the Person Running Your Ads",
    body: "No account manager relaying your questions to someone you never meet. You've got a direct line to the person actually running your ads, and questions get answered the same day.",
    iconPath: "M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155",
  },
  {
    title: "Two Platforms. Nothing Else.",
    body: "Google Ads and Meta Ads. That's it. No SEO, no web design, no social media retainers. We've managed $20M+ in ad spend across 200+ businesses, and we're not trying to be everything to everyone.",
    iconPath: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z",
  },
];

const differentiatorThemes = [
  {
    title: "Only Two Platforms, Mastered",
    items: [
      "Google and Meta ads only. Nothing else.",
      "A dedicated specialist for every piece: ad creatives, conversion tracking, landing pages, CRM, and email flows",
      "Our platform expertise combined with your industry knowledge",
    ],
  },
  {
    title: "You Can Actually Reach Us",
    items: [
      "One direct channel with your whole account team",
      "Same-day responses to any question or issue",
      "Boutique by design: every specialist works with a maximum of 10 clients",
      "Senior specialists only. No juniors learning on your budget.",
    ],
  },
  {
    title: "Pricing Built Around Your Results",
    items: [
      "Performance pricing: we make more as you make more",
      "7-day money-back guarantee",
      "First call is about fit, not a pitch",
      "No long-term contracts",
    ],
  },
  {
    title: "Nothing Gets Lost",
    items: [
      "Live custom reporting connected to your real data. Check it any time. No vanity metrics.",
      "The Creekside Brain: every detail of your account, strategy, and history in one system, so when you ask a question three months in, we actually know the answer",
      "Bi-weekly reports that answer four questions: what worked, what didn't, what's next, and what we need from you",
      "Server-side, first-party conversion tracking plus offline CRM data fed back to the ad platforms",
    ],
  },
];
---

<Layout
  title="Google Ads & Meta Ads Management | Creekside Marketing"
  description="Stop wasting ad spend and grow your revenue. Creekside Marketing Pros helps businesses improve ROAS with expert Google and Meta Ads management. Claim your free $10K Profit Recovery Audit today."
  canonicalURL="https://creeksidemarketingpros.com/"
  schema={siteSchema.home}
  faqSchema={faqSchemas.home}
>
  <Nav /> 

  <!-- ========== 1. HERO ========== -->
  <section
    class="relative min-h-dvh flex items-center overflow-hidden bg-primary-900 py-20 lg:py-32"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/hero-image.avif"
        alt="Creekside Marketing Background"
        width="1800"
        height="768"
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-primary-900/95 via-primary-900/80 to-primary-900/40"
      ></div>
    </div>

    <div class="container relative z-10 mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <span
            class="mb-4 block text-sm/none font-bold tracking-widest uppercase text-secondary-300"
          >
            Creekside Marketing Pros
          </span>

          <h1
            class="flex flex-col gap-2 text-4xl/tight font-extrabold text-white md:text-6xl/tight lg:text-5xl/tight xl:text-6xl/tight"
          >
            <span>Stop Wasting Ad Spend.</span>
            <span class="text-secondary-400">Start Growing Revenue.</span>
          </h1>

          <p
            class="mt-8 max-w-2xl text-lg/8 text-grey-200 md:text-xl/9 lg:text-lg/8"
          >
            We work with businesses spending $10k - $100k/month on Google and
            Meta ads.
            <strong class="text-white"
              >If we don't improve your ROAS within 90 days, we work for free
              until we do.</strong
            >
            And if you decide in the first 7 days it's not a good fit, you get
            every dollar back. Honestly, we'd rather know that up front.
          </p>

          <div class="mt-10 flex flex-wrap gap-8 md:gap-16">
            <div>
              <div class="text-3xl/none font-bold text-white md:text-4xl/none">
                $20M+
              </div>
              <div
                class="mt-2 text-sm/6 font-medium text-grey-400 uppercase tracking-wide"
              >
                In Ad Spend Managed
              </div>
            </div>
            <div>
              <div class="text-3xl/none font-bold text-white md:text-4xl/none">
                200+
              </div>
              <div
                class="mt-2 text-sm/6 font-medium text-grey-400 uppercase tracking-wide"
              >
                Businesses Served
              </div>
            </div>
          </div>

          <div class="mt-8">
            <GuaranteeBadges dark />
          </div>

          <div class="mt-10">
            <a
              href="/start/"
              class="inline-block rounded-sm bg-secondary-500 px-8 py-4 text-lg font-bold text-white shadow-sm transition-all hover:bg-secondary-600 hover:shadow-md hover:translate-y-[-2px] active:scale-95"
            >
              See How Much Money You Could Be Making
            </a>
          </div>
        </div>

        <div class="hidden lg:block">
          <div
            id="video-wrapper"
            class="aspect-video w-full overflow-hidden rounded-lg shadow-2xl relative bg-black group cursor-pointer transform-gpu"
          >
            <!-- The Facade Placeholder (Loads instantly with 0MB YouTube overhead) -->
            <div
              id="video-facade"
              class="absolute inset-0 size-full flex items-center justify-center"
              onclick="activateYoutubeEmbed()"
            >
              <!-- Background Thumbnail -->
              <img
                src="/youtube-dummy-image.avif"
                alt="Creekside Marketing Introduction Video Thumbnail"
                class="absolute inset-0 size-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
        <script is:inline>
          function activateYoutubeEmbed() {
            const container = document.getElementById("video-wrapper");

            // Notice we appended &autoplay=1 so the user doesn't have to click play a second time
            container.innerHTML = `
    <iframe
      src="https://www.youtube.com/embed/5Kb0pe6qaQc?autoplay=1"
      title="Creekside Marketing Introduction"
      class="size-full absolute inset-0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  `;
          }
        </script>
      </div>
    </div>
  </section>

  <!-- ========== 1B. CLIENT LOGO MARQUEE ========== -->
  <LogoMarquee />

  <!-- ========== 2. WHY CHOOSE CREEKSIDE ========== -->
  <section class="dot-grid bg-white py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2
          class="text-4xl/tight font-extrabold tracking-tight text-primary-900 md:text-5xl/tight"
        >
          Why Fast-Growing Companies
          <span class="text-secondary-500">Choose Creekside</span>
        </h2>
        <p class="mt-6 text-lg/8 text-grey-700">
          Other marketing agencies call us when they're stuck. Here's why.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3">
        {featuredDifferentiators.map((card) => (
          <div class="rounded-lg border border-grey-200 bg-grey-50 p-8 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-5 flex size-12 items-center justify-center rounded-full bg-secondary-500/10">
              <svg
                class="size-6 text-secondary-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={card.iconPath} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-primary-900">{card.title}</h3>
            <p class="mt-3 text-base/7 text-grey-600">{card.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        {differentiatorThemes.map((theme) => (
          <div class="rounded-lg border border-grey-200 bg-grey-50 p-8 shadow-sm transition-shadow hover:shadow-md">
            <h3 class="text-lg font-bold uppercase tracking-wide text-primary-900">
              {theme.title}
            </h3>
            <ul class="mt-5 flex flex-col gap-3">
              {theme.items.map((item) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="mt-1 size-5 shrink-0 text-accent-success"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span class="text-base/7 text-grey-600">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== FREE AUDIT CTA ========== -->
  <section class="bg-secondary-500 py-16 lg:py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl/tight font-extrabold text-white md:text-4xl/tight">
          Get Your Free $10K Profit Recovery Audit
        </h2>
        <p class="mt-4 text-lg/8 text-white/90">
          Discover the 5-7 hidden leaks draining thousands from your Google and
          Meta ad accounts. Our 247-point checklist identifies exactly where
          your money is going. Most fixes take less than 20 minutes.
        </p>
        <div class="mt-8">
          <a
            href="/start/"
            class="inline-block rounded-sm bg-white px-8 py-4 text-lg font-bold text-secondary-600 shadow-sm transition-all hover:bg-grey-100 hover:shadow-md hover:translate-y-[-2px] active:scale-95"
          >
            See If We're a Good Fit &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 4. HOW WE WORK TOGETHER ========== -->
  <section class="wash-sky bg-grey-50 py-20 lg:py-28">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2
          class="text-4xl/tight font-extrabold tracking-tight text-primary-900 md:text-5xl/tight"
        >
          How We <span class="text-secondary-500">Work Together</span>
        </h2>
        <p class="mt-6 text-lg/8 text-grey-700">
          We'll be upfront: this is the part of the page where every agency
          shows you their process graphic. Here's the honest version of ours.
        </p>
      </div>

      <div class="mx-auto mt-16 flex max-w-3xl flex-col gap-6">
        <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm">
          <div class="flex items-start gap-6">
            <div
              class="flex size-14 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-lg font-bold text-secondary-500"
            >
              01
            </div>
            <div>
              <h3 class="text-xl font-bold text-primary-900">Consultation</h3>
              <p class="mt-3 text-base/7 text-grey-600">
                Book a free call where we'll audit your current ad accounts
                live. The whole point is to figure out together whether working
                with us actually makes sense. If it doesn't, we'll tell you
                that too.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm">
          <div class="flex items-start gap-6">
            <div
              class="flex size-14 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-lg font-bold text-secondary-500"
            >
              02
            </div>
            <div>
              <h3 class="text-xl font-bold text-primary-900">90-Day Strategy</h3>
              <p class="mt-3 text-base/7 text-grey-600">
                We build a custom 90-day plan around your actual business: your
                goals, your budget, your industry. Nothing templated. If your
                situation looks like someone we've already helped, we'll tell
                you that, but the plan still gets built for you.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm">
          <div class="flex items-start gap-6">
            <div
              class="flex size-14 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-lg font-bold text-secondary-500"
            >
              03
            </div>
            <div>
              <h3 class="text-xl font-bold text-primary-900">Here's What We Found</h3>
              <p class="mt-3 text-base/7 text-grey-600">
                Before you spend a dollar with us, we show you exactly what we
                found in your accounts, what we'd do about it, and why. No
                vague promises. Just the plan, in writing.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm">
          <div class="flex items-start gap-6">
            <div
              class="flex size-14 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-lg font-bold text-secondary-500"
            >
              04
            </div>
            <div>
              <h3 class="text-xl font-bold text-primary-900">We Build and Launch</h3>
              <p class="mt-3 text-base/7 text-grey-600">
                Once you're ready, we build out the campaigns and start
                running. Weekly optimization from day one. We're not waiting 30
                days to figure out what's working.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm">
          <div class="flex items-start gap-6">
            <div
              class="flex size-14 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-lg font-bold text-secondary-500"
            >
              05
            </div>
            <div>
              <h3 class="text-xl font-bold text-primary-900">Ongoing, For Real</h3>
              <p class="mt-3 text-base/7 text-grey-600">
                You've got a direct line to your account team, not a support
                ticket queue. Same-day answers. Every two weeks you get a
                report that covers what worked, what didn't, what's next, and
                what we need from you. No fluff.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 5. VIDEO TESTIMONIALS ========== -->
  <VideoTestimonials />

  <!-- ========== 6. SERVICES ========== -->
  <section id="service" class="dot-grid bg-grey-50 py-20 lg:py-32">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2
          class="text-4xl/tight font-extrabold tracking-tight text-primary-900 md:text-5xl/tight"
        >
          Our <span class="text-secondary-500 uppercase">Services</span>
        </h2>
        <p class="mt-6 text-lg/8 text-grey-700">
          Google Ads and Meta Ads. That's the whole list. We've said no to a
          lot of other work over the years, and honestly that's kind of the
          point.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div
          class="flex flex-col rounded-sm bg-white p-8 shadow-sm transition-shadow hover:shadow-md border-t-4 border-secondary-500"
        >
          <h3
            class="text-2xl font-extrabold text-primary-900 uppercase tracking-tight"
          >
            Google Ads (PPC)
          </h3>
          <div class="my-6 h-0.5 w-full bg-grey-200">
            <div class="h-0.5 w-24 bg-secondary-500"></div>
          </div>
          <p class="grow text-base/7 text-grey-600">
            Search, YouTube, Shopping, Display, and Gmail. We build campaigns
            around your revenue goals, then optimize weekly so every dollar of
            spend has a job.
          </p>
          <div class="mt-8">
            <a
              href="/digital-advertising/google-ads/"
              class="inline-flex items-center gap-2 rounded-sm bg-secondary-500 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-secondary-600"
            >
              <svg
                class="size-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M9 5l7 7-7 7"
                />
              </svg>
              Get started with Google Ads
            </a>
          </div>
        </div>

        <div
          class="flex flex-col rounded-sm bg-white p-8 shadow-sm transition-shadow hover:shadow-md border-t-4 border-secondary-500"
        >
          <h3
            class="text-2xl font-extrabold text-primary-900 uppercase tracking-tight"
          >
            Meta Ads
          </h3>
          <div class="my-6 h-0.5 w-full bg-grey-200">
            <div class="h-0.5 w-24 bg-secondary-500"></div>
          </div>
          <p class="grow text-base/7 text-grey-600">
            Facebook, Instagram, WhatsApp, and Advantage+. Creative testing,
            precise audiences, and budget pacing built to turn cold traffic
            into customers.
          </p>
          <div class="mt-8">
            <a
              href="/digital-advertising/meta-ads/"
              class="inline-flex items-center gap-2 rounded-sm bg-secondary-500 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-colors hover:bg-secondary-600"
            >
              <svg
                class="size-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M9 5l7 7-7 7"
                />
              </svg>
              Start advertising with Meta Ads
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 7. ABOUT US ========== -->
  <section class="wash-sky bg-white py-16 lg:py-24">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="flex flex-col items-center gap-10 md:items-start">
          <div class="grid w-full grid-cols-2 gap-6 sm:gap-8">
            <div class="flex flex-col items-center">
              <div
                class="aspect-3/4 w-full max-w-48 overflow-hidden rounded-sm bg-grey-100 shadow-sm md:max-w-56"
              >
                <img
                  src="/peterson-rainey.avif"
                  alt="Peterson Rainey"
                  width="1024"
                  height="1464"
                  class="size-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="mt-4 text-center">
                <h4 class="text-base font-bold text-primary-900 md:text-lg">
                  Peterson Rainey
                </h4>
                <p class="text-xs font-medium text-grey-600 md:text-sm">
                  Co-Founder
                </p>
              </div>
            </div>

            <div class="flex flex-col items-center">
              <div
                class="aspect-3/4 w-full max-w-48 overflow-hidden rounded-sm bg-grey-100 shadow-sm md:max-w-56"
              >
                <img
                  src="/cade-maclean.avif"
                  alt="Cade Maclean"
                  width="1024"
                  height="1464"
                  class="size-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="mt-4 text-center">
                <h4 class="text-base font-bold text-primary-900 md:text-lg">
                  Cade Maclean
                </h4>
                <p class="text-xs font-medium text-grey-600 md:text-sm">
                  Co-Founder
                </p>
              </div>
            </div>
          </div>

          <div class="h-1 w-24 bg-secondary-300"></div>
        </div>

        <div class="flex flex-col items-start">
          <h2
            class="text-5xl/none font-extrabold tracking-tight text-primary-900 md:text-6xl/none"
          >
            ABOUT <span class="text-secondary-500">US</span>
          </h2>

          <div
            class="mt-8 flex flex-col gap-6 text-base/7 text-grey-700 md:text-lg/8"
          >
            <p>
              Founded by longtime friends Cade and Peterson in 2021, Creekside
              has helped businesses across dozens of industries turn paid
              advertising into their most reliable growth channel.
            </p>
            <p>
              Cade, with a background in accounting and an MBA, leads Meta Ads.
              Peterson, a mechanical engineer, leads Google Ads. That
              numbers-first DNA is why other marketing professionals call us
              when they're stuck, and it shapes how we run every account.
            </p>
            <p class="font-medium text-primary-900">
              Strategic decisions, continuous optimization, and custom
              strategies built around your goals. Let's grow your business
              together.
            </p>
          </div>

          <a
            href="#service"
            class="mt-10 inline-block rounded-sm bg-secondary-500 px-8 py-3 text-sm font-bold tracking-widest uppercase text-white shadow-sm transition-all hover:bg-secondary-600 hover:shadow-md active:scale-95"
          >
            Our Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 8. TESTIMONIAL SCREENSHOTS ========== -->
  <TestimonialScreenshots />

  <!-- ========== 9. IS CREEKSIDE RIGHT FOR YOU? ========== -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2
          class="text-4xl/tight font-extrabold tracking-tight text-primary-900 md:text-5xl/tight"
        >
          Is This <span class="text-secondary-500">a Good Fit?</span>
