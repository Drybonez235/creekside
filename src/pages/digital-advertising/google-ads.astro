---
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro'
import Layout from '../../layouts/Layout.astro';
import ServiceCommitments from '../../components/ServiceCommitments.astro';
import { siteSchema, faqSchemas } from '../../data/structuredData';

import '../../styles/global.css';

const results = [
  {
    src: "/case-study-screenshots/luggage-drop-google-ads.webp",
    industry: "Travel Services (Ecommerce)",
    metric: "1,050 purchases at $2.44 each",
    note: "Purchases up 804 vs the prior period",
    alt: "Google Ads screenshot showing 1,050 purchases at $2.44 cost per conversion for a travel services client",
  },
  {
    src: "/case-study-screenshots/root-hair-google-ads.webp",
    industry: "Hair Restoration",
    metric: "690 conversions, cost down $44 each",
    note: "205 more conversions than the prior period",
    alt: "Google Ads screenshot showing 690 conversions with cost per conversion down $44 for a hair restoration client",
  },
  {
    src: "/case-study-screenshots/nyc-notary-google-ads.webp",
    industry: "Professional Services",
    metric: "440 conversions at $27.92 each",
    note: "Cost per conversion down $16 vs the prior period",
    alt: "Google Ads screenshot showing 440 conversions at $27.92 cost per conversion for a notary services client",
  },
  {
    src: "/case-study-screenshots/winterbotham-google-ads.webp",
    industry: "Bankruptcy Law",
    metric: "229 conversions, cost down $35.80 each",
    note: "Conversions nearly doubled vs the prior period",
    alt: "Google Ads screenshot showing 229 conversions with cost per conversion down $35.80 for a bankruptcy law firm",
  },
  {
    src: "/case-study-screenshots/green-shield-pest-google-ads.webp",
    industry: "Pest Control",
    metric: "79 conversions, up 20 period over period",
    note: "Cost per conversion down $21.53",
    alt: "Google Ads screenshot showing 79 conversions with cost per conversion down $21.53 for a pest control client",
  },
  {
    src: "/case-study-screenshots/lewis-llewellyn-google-ads.webp",
    industry: "Law Firm",
    metric: "39 conversions, cost down $201 each",
    note: "Conversions up 25 vs the prior period",
    alt: "Google Ads screenshot showing 39 conversions with cost per conversion down $201 for a law firm client",
  },
];
---

<Layout
	title="Google Ads - Creekside Marketing" 
  description="Maximize online visibility with expert Google Ads management. Backed by $20M+ in audited spend, we build high-converting, tightly themed campaigns with expert GA4 tracking to drive real ROI."
  canonicalURL="https://creeksidemarketingpros.com/digital-advertising/google-ads/"
  schema={siteSchema.googleAds}
  faqSchema={faqSchemas.googleAds}
  >
	<Nav />
    <section class="wash-sky bg-grey-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      
      <div class="flex flex-col gap-6">
        <header class="flex flex-col gap-4">
          <h1 class="text-primary-900 text-3xl font-extrabold tracking-tight sm:text-4xl/tight lg:text-5xl/tight">
            MAXIMIZE YOUR ONLINE VISIBILITY WITH 
            <span class="text-secondary-500 block">GOOGLE ADS</span>
          </h1>
          <div class="bg-secondary-500 h-1.5 w-20 rounded-full"></div>
        </header>

        <div class="text-grey-700 flex flex-col gap-4 text-lg/8">
          <p>
            Creekside Marketing combines <strong>$20M+ in audited ad spend</strong>, 
            200+ account audits, and high-performing frameworks to make Google Ads
            work for your business, not the other way around. We build tightly themed,
            conversion-focused campaigns that show up when high-intent customers are searching.
          </p>
          <p>
            Every campaign is backed by expert tracking, constant optimization,
            and clear reporting.
          </p>
        </div>
      </div>

      <div class="relative flex justify-center">
        <div class="absolute -top-12 -left-12 -z-10 size-48 opacity-20">
            <div class="bg-grey-300 h-px w-full rotate-45 transform"></div>
        </div>
        
        <div class="">
          <img 
            src="/google-ads-preview.avif" 
            alt="Google Ads Preview" 
            width="948" 
            height="1044"
            loading="eager"
            class="h-auto max-w-full rounded-2xl"
          />
        </div>

        <div class="absolute -right-12 -bottom-12 -z-10 size-48 opacity-20">
            <div class="bg-grey-300 h-px w-full rotate-45 transform"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="dot-grid bg-white py-16 md:py-24" >
  <div class="container mx-auto max-w-7xl px-4 lg:px-8">

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      
      <div class="flex flex-col items-center rounded-lg border-t-4 border-secondary-500 bg-gradient-to-b from-secondary-50 to-white p-10 text-center shadow-md ring-1 ring-grey-200 transition-shadow hover:shadow-lg">
        <div class="mb-6 flex size-12 items-center justify-center text-primary-900">
			<img src="/date-range-svgrepo-com.svg" alt="A calendar icon">
        </div>
        <h3 class="text-lg/none font-bold tracking-wider uppercase text-black">
          PERFORMANCE DATA & AD ANALYSIS
        </h3>
        <div class="my-6 h-0.5 w-48 bg-secondary-500"></div>
        <p class="text-base/6 font-medium text-grey-900">
          Bi-weekly reviews of your Google Ads data, targeting insights, and ROI metrics to ensure optimal campaign performance
        </p>
      </div>

      <div class="flex flex-col items-center rounded-lg border-t-4 border-secondary-500 bg-gradient-to-b from-secondary-50 to-white p-10 text-center shadow-md ring-1 ring-grey-200 transition-shadow hover:shadow-lg">
        <div class="mb-6 flex size-12 items-center justify-center text-primary-900">
          <img src="/bar-chart-02-svgrepo-com.svg" alt="A bar chart with ascending lines">
        </div>
        <h3 class="text-lg/none font-bold tracking-wider uppercase text-black">
          GOOGLE ADS CAMPAIGN OPTIMIZATION
        </h3>
        <div class="my-6 h-0.5 w-48 bg-secondary-500"></div>
        <p class="text-base/6 font-medium text-grey-900">
          We manage and optimize your Google Ads from setup to scale, driving more clicks and conversions at lower costs
        </p>
      </div>

      <div class="flex flex-col items-center rounded-lg border-t-4 border-secondary-500 bg-gradient-to-b from-secondary-50 to-white p-10 text-center shadow-md ring-1 ring-grey-200 transition-shadow hover:shadow-lg">
        <div class="mb-6 flex size-12 items-center justify-center text-primary-900">
          <img src="/spreadsheet-chart-svgrepo-com.svg" alt="Spreadsheet with line graph">
        </div>
        <h3 class="text-lg/none font-bold tracking-wider uppercase text-black">
          CONVERSION TRACKING & REPORTING
        </h3>
        <div class="my-6 h-0.5 w-48 bg-secondary-500"></div>
        <p class="text-base/6 font-medium text-grey-900">
          We track every lead, call, and form submission using GA4 and GTM, giving us actionable insights to improve your ad performance.
        </p>
      </div>

    </div>
  </div>
</section>

<section class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      
      <header>
        <h2 class="text-primary-900 text-4xl/tight font-extrabold tracking-tight md:text-5xl/tight">
          Drive <span class="text-secondary-500">Targeted Traffic</span> and Measure Success
        </h2>
      </header>

      <div class="flex flex-col gap-6 text-grey-700 text-lg/8">
        <div class="flex flex-col gap-4">
          <p>
            We track every click, call, form fill, and booking with server-side,
            first-party tracking built on <strong>GA4 and Google Tag Manager</strong>.
            No guessing which ads are working. Your entire funnel is measured.
          </p>
          <p>
            Then we go a step further: offline conversion data from your CRM flows
            back into Google Ads, so the bidding algorithms optimize toward actual
            revenue, not just form fills. Our team handles everything from launch
            to optimization, including:
          </p>
        </div>

        <ul class="flex flex-col gap-2 font-semibold text-primary-800">
          <li class="flex items-center gap-2">
            <span class="bg-secondary-500 size-1.5 rounded-full"></span>
            Keyword research & negative keyword pruning
          </li>
          <li class="flex items-center gap-2">
            <span class="bg-secondary-500 size-1.5 rounded-full"></span>
            Ad copy A/B testing
          </li>
          <li class="flex items-center gap-2">
            <span class="bg-secondary-500 size-1.5 rounded-full"></span>
            Manual or smart bidding (based on data)
          </li>
          <li class="flex items-center gap-2">
            <span class="bg-secondary-500 size-1.5 rounded-full"></span>
            Weekly optimizations and strategic scaling
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      <div class="drop-shadow-sm transition-all duration-500 hover:drop-shadow-md">
        <img 
          src="/google-web-analytics-one.avif" 
          alt="Performance Dashboard 1" 
          width="1800" 
          height="618"
          class="rounded-sm"
          loading="lazy"
        />
      </div>
      <div class="drop-shadow-sm transition-all duration-500 hover:drop-shadow-md">
        <img 
          src="/google-web-analytics-two.avif" 
          alt="Performance Dashboard 2" 
          width="1800" 
          height="620"
          class="rounded-sm"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<!-- Performance proof gallery -->
<section class="wash-sky bg-grey-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mb-12 text-center">
      <h2 class="text-primary-900 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">
        Results Straight From <span class="text-secondary-500">Google Ads</span>
      </h2>
      <div class="bg-secondary-500 mx-auto mt-4 h-1.5 w-20 rounded-full"></div>
      <p class="text-grey-600 mx-auto mt-6 max-w-2xl text-lg/8">
        No polished slide decks. These are live client accounts inside the Google Ads
        platform, each compared against the period before we made changes.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {results.map((result) => (
        <figure class="overflow-hidden rounded-lg bg-white shadow-md ring-1 ring-grey-200 transition-shadow hover:shadow-lg">
          <img
            src={result.src}
            alt={result.alt}
            width="1600"
            height="700"
            loading="lazy"
            class="w-full border-b border-grey-100"
          />
          <figcaption class="flex flex-col gap-1 px-6 py-5">
            <span class="text-xs font-bold uppercase tracking-wider text-secondary-700">{result.industry}</span>
            <span class="text-primary-900 text-lg font-extrabold">{result.metric}</span>
            <span class="text-grey-600 text-sm">{result.note}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
    <ServiceCommitments platform="Google Ads" />
    <Footer />
</Layout>