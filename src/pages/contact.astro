---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Form from '../components/Form.astro';
import GuaranteeBadges from '../components/GuaranteeBadges.astro';
import { siteSchema } from '../data/structuredData';
import { START_URL } from '../data/site';
import '../styles/global.css';
---

<Layout
  title="Contact - Creekside Marketing"
  description="Ready to grow your revenue? Contact Creekside Marketing Pros today for expert Google and Meta Ads management. Call (931) 342-4114 or message us to start your $10K Profit Recovery Audit."
  canonicalURL="https://creeksidemarketingpros.com/contact/"
  schema={siteSchema.contact}
>
  <Nav />
  
  <main class="bg-grey-50 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-x-16 gap-y-12 lg:grid-cols-2">
        
        <div class="flex flex-col justify-center">
          <h1 class="text-5xl/tight font-black tracking-tight text-primary-900 md:text-6xl/tight">
            CONTACT US
          </h1>
          <p class="mt-6 text-lg/8 text-grey-600">
            Message us and you'll hear back the same day. Fill out the form, email, or call, and a member of the team will reach out directly.
          </p>

          <div class="mt-10">
            <h2 class="text-primary-900 text-lg font-bold uppercase tracking-wide">What Happens Next</h2>
            <ol class="mt-5 flex flex-col gap-4">
              <li class="flex items-start gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-sm font-bold text-secondary-500">1</span>
                <p class="text-base/7 text-grey-600">
                  <span class="font-bold text-primary-900">Same-day reply.</span>
                  A real person from the team gets back to you, not an autoresponder.
                </p>
              </li>
              <li class="flex items-start gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-sm font-bold text-secondary-500">2</span>
                <p class="text-base/7 text-grey-600">
                  <span class="font-bold text-primary-900">Free live audit call.</span>
                  We dig into your accounts together and figure out whether we're the right fit.
                </p>
              </li>
              <li class="flex items-start gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-sm font-bold text-secondary-500">3</span>
                <p class="text-base/7 text-grey-600">
                  <span class="font-bold text-primary-900">Risk-free start.</span>
                  If we work together, your first 7 days are covered by a full money-back guarantee.
                </p>
              </li>
            </ol>
          </div>

          <div class="mt-8">
            <GuaranteeBadges />
          </div>

          <p class="mt-8 text-base/7 text-grey-600">
            Prefer to skip the form?
            <a
              href={START_URL}
              class="font-bold text-secondary-500 transition-colors hover:text-secondary-600"
            >
              Book your free audit call directly.
            </a>
          </p>

          <dl class="mt-10 space-y-6 text-base/7 text-grey-600">
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Telephone</span>
                <svg class="size-7 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
              </dt>
              <dd><a class="hover:text-primary-900 transition-colors" href="tel:+19313424114">(931) 342-4114</a></dd>
            </div>
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Email</span>
                <svg class="size-7 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
              </dt>
              <dd><a class="hover:text-primary-900 transition-colors" href="mailto:info@creeksidemarketingpros.com">info@creeksidemarketingpros.com</a></dd>
            </div>
          </dl>
        </div>

        <div class="relative">
          <Form idPrefix="ContactPage" />
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>