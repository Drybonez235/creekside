---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Newsletter - Creekside Marketing"
  description="Stories from inside a growing agency. Peterson Rainey shares the wins, the losses, and the real strategies behind the ads we run for businesses across the country."
  canonicalURL="https://creeksidemarketingpros.com/newsletter/"
  showPopup={false}
>
  <Nav />

  <main class="bg-grey-50 py-24 md:py-32">
    <div class="mx-auto max-w-xl px-6 text-center">

      <p class="text-sm font-semibold uppercase tracking-widest text-secondary-500">
        Newsletter name: TBD
      </p>

      <h1 class="mt-4 text-5xl font-black tracking-tight text-primary-900 md:text-6xl">
        We have great content.<br />We're still workshopping the name.
      </h1>

      <p class="mt-6 text-lg/8 text-grey-600">
        Every week I write about what's actually happening inside our agency and the accounts we manage. The wins, the losses, what we tried that flopped, and what's making our clients real money right now. Stories from the front lines of running Google and Meta ads for businesses across the country, plus lessons from building Creekside itself.
      </p>

      <p class="mt-4 text-lg/8 text-grey-600">
        All things business. All things growth. Zero AI slop.
      </p>

      <form
        action="https://buttondown.com/api/emails/embed-subscribe/creekside"
        method="post"
        target="_blank"
        class="mt-10 flex flex-col sm:flex-row gap-3"
      >
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="flex-1 rounded-lg border border-grey-300 px-4 py-3 text-base text-primary-900 placeholder-grey-400 focus:outline-none focus:ring-2 focus:ring-secondary-500"
        />
        <button
          type="submit"
          class="rounded-lg bg-primary-900 px-6 py-3 text-base font-semibold text-white hover:bg-primary-800 transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>

      <p class="mt-4 text-sm text-grey-400">
        Free. Weekly. Unsubscribe anytime.
      </p>

    </div>
  </main>

  <Footer />
</Layout>
