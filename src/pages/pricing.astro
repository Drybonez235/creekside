---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import GuaranteeBadges from '../components/GuaranteeBadges.astro';
import { siteSchema, faqSchemas } from '../data/structuredData';
import { START_URL } from '../data/site';

import '../styles/global.css';

const feeTiers = [
  { spend: "Up to $30,000", rate: "20%" },
  { spend: "$30,000 to $60,000", rate: "15%" },
  { spend: "Above $60,000", rate: "10%" },
];

const includedServices = [
  {
    title: "Campaign Management",
    body: "Full Google and Meta account management: strategy, builds, bidding, testing, and weekly optimization.",
    iconPath: "M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z",
  },
  {
    title: "Landing Pages",
    body: "High-converting landing pages designed, built, and tested for your campaigns.",
    iconPath: "M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25",
  },
  {
    title: "Ad Creatives & Copywriting",
    body: "Hooks, visuals, and ad copy produced in-house and built to convert.",
    iconPath: "M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42",
  },
  {
    title: "Conversion Tracking",
    body: "Server-side, first-party tracking with CRM integration, so the platforms optimize on real revenue.",
    iconPath: "M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z",
  },
  {
    title: "Conversion Rate Optimization",
    body: "Ongoing testing across your funnel so every click has a better chance of becoming a customer.",
    iconPath: "M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941",
  },
  {
    title: "Live Reporting",
    body: "A live custom dashboard connected to your real data, plus bi-weekly reports and monthly strategy calls.",
    iconPath: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z",
  },
];

const onboardingItems = [
  "Comprehensive audit of your existing accounts",
  "Conversion tracking setup, including server-side tracking and CRM integration",
  "A 90-day strategic plan for your accounts",
  "Landing page setup and ad creative design",
  "New campaign buildout and launch",
];

const ongoingItems = [
  "Bi-weekly reports: what worked, what didn't, what's next, and what we need from you",
  "Monthly strategy calls",
  "Budget management and pacing",
  "Search term exclusions and placement analysis on Google",
  "Ads Library research and creative testing on Meta",
  "Conversion tracking verification and pixel health checks",
  "New campaign launches and A/B testing",
];

const platforms = [
  { name: "Google Ads", channels: ["Search", "YouTube", "Display", "Gmail", "Shopping"] },
  { name: "Meta Ads", channels: ["Facebook", "Instagram", "WhatsApp", "Advantage+"] },
];

// Visible FAQ copy MUST stay word-for-word identical to faqSchemas.pricing.
const faqs = [
  {
    q: "How much does Creekside Marketing charge?",
    a: "Our management fee is a percentage of your ad spend: 20% up to $30k, 15% from $30k to $60k, and 10% above $60k per platform. There's a $1,500 monthly minimum per platform, and total fees are capped at $15,000 per month.",
  },
  {
    q: "What's included in the management fee?",
    a: "Everything required to make your ads succeed: campaign management, landing pages, ad creatives, copywriting, conversion tracking setup including server-side tracking and CRM integration, conversion rate optimization, live reporting, bi-weekly reports, and monthly strategy calls. There are no separate line items.",
  },
  {
    q: "Are there any long-term contracts?",
    a: "No. There are no long-term contracts, and your first 7 days are covered by a full money-back guarantee.",
  },
  {
    q: "Do you charge per platform?",
    a: "Yes. The fee is calculated per platform. If we manage both Google Ads and Meta Ads, each platform has its own tiered rate and $1,500 minimum, and your combined total is still capped at $15,000 per month.",
  },
  {
    q: "What guarantees do you offer?",
    a: "Two. First, a 7-day money-back guarantee: meet the team, see how we work, and if we're not the right fit within your first 7 days, you get a full refund. Second, a 90-day performance promise: if we don't improve your ROAS within 90 days, we work for free until we do.",
  },
  {
    q: "Which plan should I choose?",
    a: "There's only one pricing structure, and it works at every budget level. The percentage rate decreases as your spend grows (20% to $30k, 15% to $60k, 10% above), so the more you invest, the lower your effective rate.",
  },
];
---

<Layout
  title="Pricing - Creekside Marketing"
  description="Transparent Google Ads and Meta Ads management pricing. One fee, a percentage of ad spend, covers everything. No hidden fees, no contracts."
  canonicalURL="https://creeksidemarketingpros.com/pricing/"
  schema={siteSchema.pricing}
  faqSchema={faqSchemas.pricing}
>
  <Nav />

  <!-- Hero Section -->
  <section class="bg-grey-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-6 text-center">
        <header class="flex flex-col items-center gap-4">
          <h1 class="text-primary-900 text-3xl font-extrabold tracking-tight sm:text-4xl/tight lg:text-5xl/tight">
            One Rate. <span class="text-secondary-500">Everything Included.</span>
          </h1>
          <div class="bg-secondary-500 h-1.5 w-20 rounded-full"></div>
        </header>
        <p class="text-grey-700 max-w-2xl text-lg/8">
          One fee, a percentage of your ad spend, covers everything required to make your ads succeed. The rate drops as you scale.
        </p>
        <div class="flex justify-center">
          <GuaranteeBadges />
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Card Section -->
  <section class="bg-white py-16 md:py-24">
    <div class="container mx-auto max-w-3xl px-4 lg:px-8">

      <div class="relative flex flex-col rounded-sm border-2 border-secondary-500 bg-white shadow-md">
        <div class="h-1 w-full rounded-t-sm bg-secondary-500"></div>
        <div class="flex flex-1 flex-col p-8 pt-10">
          <div class="mb-6 text-center">
            <p class="text-sm font-bold uppercase tracking-widest text-secondary-500">Percentage of Ad Spend</p>
            <h2 class="text-primary-900 text-2xl font-extrabold uppercase tracking-tight">Management Fee</h2>
          </div>

          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-grey-200">
                <th scope="col" class="py-3 text-sm font-bold uppercase tracking-wide text-grey-600">Monthly Ad Spend (Per Platform)</th>
                <th scope="col" class="py-3 text-right text-sm font-bold uppercase tracking-wide text-grey-600">Fee Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-grey-100">
              {feeTiers.map((tier) => (
                <tr>
                  <td class="py-4 text-base font-medium text-grey-700">{tier.spend}</td>
                  <td class="py-4 text-right text-lg font-bold text-primary-900">{tier.rate}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="mt-2 divide-y divide-grey-100 border-t border-grey-200">
            <div class="flex items-baseline justify-between py-4">
              <span class="text-sm font-medium text-grey-600">Minimum Fee</span>
              <span class="text-lg font-bold text-primary-900">$1,500<span class="text-sm font-medium text-grey-500">/mo per platform</span></span>
            </div>
            <div class="flex items-baseline justify-between py-4">
              <span class="text-sm font-medium text-grey-600">Monthly Cap</span>
              <span class="text-lg font-bold text-primary-900">$15,000</span>
            </div>
            <div class="flex items-baseline justify-between py-4">
              <span class="text-sm font-medium text-grey-600">Long-Term Contracts</span>
              <span class="text-lg font-bold text-primary-900">None</span>
            </div>
          </div>

          <div class="mt-8">
            <a
              href={START_URL}
              class="bg-secondary-500 hover:bg-secondary-600 block w-full rounded-sm px-8 py-4 text-center text-lg font-bold uppercase tracking-wider text-white shadow-sm transition-colors duration-300"
            >
              See How Much Money You Could Be Making
            </a>
          </div>
        </div>
      </div>

      <p class="mt-4 text-center text-sm text-grey-500">
        Example: $20,000/mo in ad spend on Google Ads = $4,000/mo management fee. The $1,500 minimum fee per platform acts as a floor, covering your first $7,500 in ad spend. Once you spend over $7,500, the 20% rate naturally takes over.
      </p>

      <p class="mt-4 text-center text-sm text-grey-500 max-w-xl mx-auto">
        One question we get a lot: if we're paid on a percentage of spend, why wouldn't we just push you to spend more forever? Honestly, we don't. You set the budget. We don't recommend increasing it until the numbers justify it. And the fee is capped at $15,000/mo anyway. As you grow, we grow. That's kind of the whole point.
      </p>

    </div>
  </section>

  <!-- Everything Included Section -->
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12 flex flex-col items-center gap-4 text-center">
        <h2 class="text-primary-900 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl/tight">
          One Fee. <span class="text-secondary-500">Everything Included.</span>
        </h2>
        <div class="bg-secondary-500 h-1.5 w-20 rounded-full"></div>
        <p class="text-grey-700 max-w-2xl text-lg/8">
          No add-ons, no separate line items. Everything your ads need to succeed is covered by the management fee.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {includedServices.map((item) => (
          <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
            <div class="mb-5 flex size-12 items-center justify-center rounded-full bg-secondary-500/10">
              <svg class="size-6 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath} />
              </svg>
            </div>
            <h3 class="text-primary-900 mb-3 text-lg font-bold">{item.title}</h3>
            <p class="text-grey-600 text-base/7">{item.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="rounded-lg bg-grey-50 p-8">
          <h3 class="text-primary-900 text-xl font-bold">In Your First 30 Days</h3>
          <ul class="mt-5 flex flex-col gap-3">
            {onboardingItems.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 size-5 shrink-0 text-accent-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span class="text-base/7 text-grey-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg bg-grey-50 p-8">
          <h3 class="text-primary-900 text-xl font-bold">Every Month After</h3>
          <ul class="mt-5 flex flex-col gap-3">
            {ongoingItems.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 size-5 shrink-0 text-accent-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span class="text-base/7 text-grey-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Coverage Section -->
  <section class="bg-grey-50 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12 flex flex-col items-center gap-4 text-center">
        <h2 class="text-primary-900 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl/tight">
          Every Channel <span class="text-secondary-500">on Both Platforms</span>
        </h2>
        <div class="bg-secondary-500 h-1.5 w-20 rounded-full"></div>
      </header>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {platforms.map((platform) => (
          <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm">
            <h3 class="text-primary-900 text-xl font-bold">{platform.name}</h3>
            <div class="mt-5 flex flex-wrap gap-2">
              {platform.channels.map((channel) => (
                <span class="inline-flex items-center rounded-full bg-secondary-500/10 px-4 py-1.5 text-sm font-bold text-primary-900 ring-1 ring-secondary-500/30">
                  {channel}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-white py-16 lg:py-24">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-4xl/tight font-extrabold tracking-tight text-primary-900 md:text-5xl/tight">
          Pricing <span class="text-secondary-500">Questions</span>
        </h2>
      </div>

      <div class="mx-auto mt-12 flex max-w-3xl flex-col gap-4">
        {faqs.map((faq) => (
          <details name="pricing-faq-accordion" class="group rounded-lg bg-grey-50 shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between p-6 text-lg font-bold text-primary-900 select-none">
              <span>{faq.q}</span>
              <span class="ml-4 shrink-0 text-secondary-500 transition-transform duration-300 group-open:rotate-45">
                <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v12m6-6H6" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-base/7 text-grey-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="freequote" class="stripes-dark bg-primary-900 py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl/tight lg:text-5xl/tight">
        Ready to grow? <span class="text-secondary-300">Let's talk.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg/8 text-primary-100/80">
        Book a free 30-minute call. We'll look at your accounts, tell you what we'd focus on first, and walk through what the fee would actually be. Worst case, you get a straight answer.
      </p>
      <div class="mt-10">
        <a
          href={START_URL}
          class="bg-secondary-500 hover:bg-secondary-600 inline-block rounded-sm px-8 py-4 text-lg font-bold uppercase tracking-wider text-white shadow-sm transition-colors duration-300"
        >
          See If We're a Good Fit
        </a>
      </div>
      <div class="mt-8 flex justify-center">
        <GuaranteeBadges dark />
      </div>
    </div>
  </section>

  <Footer />
</Layout>

