---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import ClientInfoBar from '../../components/case-study/ClientInfoBar.astro';
import MetricStrip from '../../components/case-study/MetricStrip.astro';
import SectionRenderer from '../../components/case-study/SectionRenderer.astro';
import CaseStudyFooter from '../../components/case-study/CaseStudyFooter.astro';
import RelatedStudies from '../../components/case-study/RelatedStudies.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map(study => ({
    params: { slug: study.slug },
    props: { study, allStudies: studies },
    props: { study, allStudies: studies },
  }));
}

const { study, allStudies } = Astro.props;

// Find related studies by industry + tag overlap
const platformTags = new Set(['google ads', 'meta ads', 'facebook ads', 'instagram ads', 'paid social', 'paid search', 'ppc']);
const currentTags = new Set(study.data.tags.map((t: string) => t.toLowerCase()));
const currentIndustry = study.data.category.split(':')[0].trim().split(' ')[0].toLowerCase();
const others = allStudies.filter((s: typeof study) => s.slug !== study.slug);
const scored = others.map((s: typeof study) => {
  const otherIndustry = s.data.category.split(':')[0].trim().split(' ')[0].toLowerCase();
  const sameIndustry = otherIndustry === currentIndustry ? 5 : 0;
  const overlap = s.data.tags.filter((t: string) => {
    const tag = t.toLowerCase();
    return currentTags.has(tag) && !platformTags.has(tag);
  }).length;
  return { study: s, score: sameIndustry + overlap * 2 };
}).sort((a: { score: number }, b: { score: number }) => b.score - a.score);
const relatedStudies = scored.slice(0, 3).map((s: { study: typeof study }) => ({
  slug: s.study.slug,
  ...s.study.data,
}));
const { Content } = await render(study);
const d = study.data;

// Determine if this study uses the rich format or legacy markdown
const hasRichFormat = d.sections && d.sections.length > 0;

// Build hero title — use heroTitle if provided, otherwise generate from title
const heroTitle = d.heroTitle || `How {CLIENT} ${d.title}`;
const heroSubtitle = d.heroSubtitle || d.summary;

// Build client info — use clientInfo if provided, otherwise generate from available data
const clientInfo = d.clientInfo || [
  { label: "Client", value: d.client },
  { label: "Category", value: d.category },
];

// Build metric strip — use metricStrip if provided, otherwise generate from metrics
const metricStrip = d.metricStrip || [
  { value: d.metrics.roas, label: "Primary Result" },
  { value: d.metrics.scale, label: "Scale Achieved" },
];

// JSON-LD schema (Article is the valid schema.org type for case studies)
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": d.title,
  "description": d.summary,
  ...(d.lastModified && { "dateModified": d.lastModified.toISOString() }),
  ...(d.lastModified && { "dateModified": d.lastModified.toISOString() }),
  "author": {
    "@type": "Organization",
    "name": "Creekside Marketing",
    "url": `${Astro.site}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Creekside Marketing",
    "logo": {
      "@type": "ImageObject",
      "url": `${Astro.site}creekside-marketing-icon-192x192.avif`
    }
  },
  "about": {
    "@type": "Organization",
    "name": d.client,
    ...(d.website && { "url": d.website }),
    "name": d.client,
    ...(d.website && { "url": d.website }),
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  "keywords": d.tags.join(", ")
};

// FAQPage schema from any faq sections
const faqItems = (d.sections || [])
  .filter((s) => s.type === 'faq' && s.faqItems)
  .flatMap((s) => s.faqItems!);

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;


// Service page links derived from category (e.g. "Dental Aesthetics: Google + Meta")
const categoryLower = d.category.toLowerCase();
const serviceLinks = [
  ...(categoryLower.includes('google') ? [{ href: '/digital-advertising/google-ads/', label: 'Google Ads Management' }] : []),
  ...(categoryLower.includes('meta') || categoryLower.includes('facebook') ? [{ href: '/digital-advertising/meta-ads/', label: 'Meta Ads Management' }] : []),
];

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${Astro.site}`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Case Studies",
      "item": `${Astro.site}case-study-digital-marketing/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": d.client,
      "item": Astro.url.href
    }
  ]
};
---

<Layout
  title={`${d.title} | Creekside Marketing`}
  title={`${d.title} | Creekside Marketing`}
  description={d.summary}
  canonicalURL={Astro.url}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

  <Nav />

  <main class="min-h-dvh bg-grey-50">
    <!-- Back navigation -->
    <aside class="hidden lg:block">
      <div class="mx-auto max-w-7xl px-4 pt-6 lg:px-12">
        <a
          href="/case-study-digital-marketing/"
          class="group inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-secondary-600 transition-colors hover:text-primary-900"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to all results
        </a>
      </div>
    </aside>

    <!-- Case Study Content -->
    <div class="mx-auto mt-6 max-w-[1000px] overflow-hidden bg-white shadow-xl">
      <!-- Hero -->
      <CaseStudyHero
        heroBadge={d.heroBadge || "Client Case Study"}
        heroTitle={heroTitle}
        clientName={d.client}
        heroSubtitle={heroSubtitle}
      />

      <!-- Client Info Bar -->
      <ClientInfoBar items={clientInfo} website={d.website} />
      <ClientInfoBar items={clientInfo} website={d.website} />

      <!-- Metric Strip -->
      <MetricStrip metrics={metricStrip} />

      {hasRichFormat ? (
        <!-- Rich structured sections -->
        <div class="px-8 py-12 md:px-14">
          {d.sections!.map((section) => (
            <div class="mb-11 last:mb-0">
              <SectionRenderer section={section} />
            </div>
          ))}
        </div>
      ) : (
        <!-- Legacy markdown content with prose styling -->
        <div class="px-8 py-12 md:px-14">
          <div class="prose prose-grey max-w-none
            prose-headings:text-primary-900 prose-headings:font-bold
            prose-p:text-grey-700 prose-p:text-lg/8
            prose-strong:text-primary-900
            prose-ul:list-none prose-ul:ps-0
            prose-li:relative prose-li:ps-8 prose-li:mb-4
            prose-li:before:absolute prose-li:before:left-0 prose-li:before:top-3
            prose-li:before:size-2 prose-li:before:rounded-full prose-li:before:bg-secondary-500">
            <Content />
          </div>
        </div>
      )}

      {serviceLinks.length > 0 && (
        <!-- Services used -->
        <div class="border-t border-gray-100 px-8 py-8 md:px-14">
          <span class="mb-3 inline-block text-[0.65rem] font-bold uppercase tracking-[2.5px] text-secondary-600">
            Services Used In This Case Study
          </span>
          <div class="flex flex-wrap gap-3">
            {serviceLinks.map((link) => (
              <a
                href={link.href}
                class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-semibold text-primary-900 transition-colors hover:border-secondary-500 hover:text-secondary-600"
              >
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Studies -->
      <RelatedStudies studies={relatedStudies} />

      <!-- Footer -->
      <CaseStudyFooter ctaText={d.footerCta || "Ready to see results like these?"} />
    </div>
  </main>

  <Footer />
</Layout>
