---
// Voice kit: labeled callout for the off-script line. Max 1 per page.
interface Props {
  label?: string;
}
const { label = 'Honest answer:' } = Astro.props;
---

<aside class="mx-auto max-w-2xl rounded-sm border-l-4 border-secondary-500 bg-secondary-50 px-6 py-5">
  <p class="hand-script text-2xl/7 text-secondary-700">{label}</p>
  <p class="mt-2 text-base/7 text-grey-700"><slot /></p>
</aside>
