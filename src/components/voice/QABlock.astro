---
// Voice kit: conversational objection block. The question a prospect would
// actually ask, then the plain-voice answer. Replaces dense paragraphs.
interface Props {
  question: string;
}
const { question } = Astro.props;
---

<div class="mx-auto max-w-2xl">
  <p class="text-lg/7 font-bold text-primary-900">&ldquo;{question}&rdquo;</p>
  <p class="mt-3 border-l-2 border-grey-200 pl-4 text-base/7 text-grey-600"><slot /></p>
</div>
