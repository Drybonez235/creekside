---
// Voice kit: handwritten margin note with a hand-drawn arrow pointing at the
// element it annotates. Parent element MUST be position:relative. Desktop only
// (hidden below xl); decorative, so aria-hidden. Max 1-2 per page.
interface Props {
  side?: 'left' | 'right';
}
const { side = 'right' } = Astro.props;
---

{side === 'right' ? (
  <div
    class="hand-script pointer-events-none absolute top-1/2 left-full ml-10 hidden w-48 -translate-y-1/2 rotate-2 items-center gap-2 xl:flex"
    aria-hidden="true"
  >
    <svg viewBox="0 0 48 24" class="h-6 w-12 shrink-0 text-secondary-500" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M46 4 C 32 4, 16 8, 4 14" />
      <path d="M12 8 L 3 14.5 L 13 17" />
    </svg>
    <span class="text-xl/6 text-secondary-600"><slot /></span>
  </div>
) : (
  <div
    class="hand-script pointer-events-none absolute top-1/2 right-full mr-10 hidden w-48 -translate-y-1/2 -rotate-3 items-center gap-2 xl:flex"
    aria-hidden="true"
  >
    <span class="text-right text-xl/6 text-secondary-600"><slot /></span>
    <svg viewBox="0 0 48 24" class="h-6 w-12 shrink-0 text-secondary-500" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 4 C 16 4, 32 8, 44 14" />
      <path d="M36 8 L 45 14.5 L 35 17" />
    </svg>
  </div>
)}
