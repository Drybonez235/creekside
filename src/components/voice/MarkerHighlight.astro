---
// Voice kit: hand-drawn marker stroke on 2-3 words inside a heading.
// Usage budget: max 1 per section, headings only.
interface Props {
  variant?: 'underline' | 'circle';
}
const { variant = 'underline' } = Astro.props;
---

<span class="relative inline-block whitespace-nowrap">
  <slot />
  {variant === 'underline' ? (
    <svg
      class="pointer-events-none absolute -bottom-2 left-0 h-3 w-full text-secondary-400"
      viewBox="0 0 120 12"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M3 9 C 30 3.5, 62 8.5, 117 5" />
    </svg>
  ) : (
    <svg
      class="pointer-events-none absolute top-1/2 left-1/2 h-[calc(100%+1.1em)] w-[calc(100%+1.4em)] -translate-x-1/2 -translate-y-1/2 text-secondary-400"
      viewBox="0 0 200 70"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M60 10 C 125 3, 194 12, 195 35 C 196 55, 135 66, 75 63 C 25 60, 5 50, 5 34 C 5 18, 35 11, 105 8" />
    </svg>
  )}
</span>
