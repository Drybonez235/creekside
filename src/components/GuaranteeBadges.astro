---
// Single source of truth for the two Creekside guarantees.
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const badges = [
  "7-Day Money-Back Guarantee",
  "90-Day ROAS Improvement, or We Work Free",
];
---

<div class="flex flex-wrap items-center gap-3">
  {badges.map((label) => (
    <span
      class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold ${
        dark
          ? "bg-white/10 text-white ring-1 ring-white/25"
          : "bg-secondary-500/10 text-primary-900 ring-1 ring-secondary-500/30"
      }`}
    >
      <svg
        class={`size-4 shrink-0 ${dark ? "text-secondary-300" : "text-secondary-500"}`}
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      {label}
    </span>
  ))}
</div>
