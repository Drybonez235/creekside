---
// Shared commitments + CTA section for the service pages.
import GuaranteeBadges from './GuaranteeBadges.astro';
import { CALENDAR_URL } from '../data/site';

interface Props {
  platform: string;
}
const { platform } = Astro.props;

const commitments = [
  {
    title: "A Specialist for Every Piece",
    body: "A dedicated specialist for every piece of your funnel: ad creatives, conversion tracking, landing pages, CRM, and email flows.",
    iconPath: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z",
  },
  {
    title: "Bi-Weekly Reports That Answer Four Questions",
    body: "What worked, what didn't, what's next, and what we need from you. Every two weeks, without you having to ask.",
    iconPath: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z",
  },
  {
    title: "A Live Dashboard, Not a Monthly PDF",
    body: "A live custom dashboard connected to your real data. Check it any time. No vanity metrics.",
    iconPath: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z",
  },
];
---

<section class="bg-grey-50 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mb-12 text-center">
      <h2 class="text-primary-900 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">
        How We Run <span class="text-secondary-500">{platform}</span> Accounts
      </h2>
      <div class="bg-secondary-500 mx-auto mt-4 h-1.5 w-20 rounded-full"></div>
      <p class="text-grey-600 mx-auto mt-6 max-w-2xl text-lg/8">
        Every {platform} engagement comes with the same commitments, because they are the reason our clients stay.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {commitments.map((item) => (
        <div class="rounded-lg border border-grey-200 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
          <div class="mb-5 flex size-12 items-center justify-center rounded-full bg-secondary-500/10">
            <svg class="size-6 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath} />
            </svg>
          </div>
          <h3 class="text-primary-900 mb-3 text-lg font-bold">{item.title}</h3>
          <p class="text-grey-600 text-base/7">{item.body}</p>
        </div>
      ))}
    </div>

    <p class="text-grey-600 mx-auto mt-10 max-w-2xl text-center text-lg/8">
      Our first call is about whether your business is ready to scale, not a pitch.
    </p>

    <div class="mt-12 rounded-lg bg-primary-900 px-8 py-12 text-center lg:px-16">
      <h3 class="text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">
        Ready to See What <span class="text-secondary-300">{platform}</span> Can Actually Do?
      </h3>
      <div class="mt-8 flex justify-center">
        <a
          href={CALENDAR_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-sm bg-secondary-500 px-8 py-4 font-bold text-white transition-colors hover:bg-secondary-600"
        >
          Book Your Free Audit Call
        </a>
      </div>
      <div class="mt-8 flex justify-center">
        <GuaranteeBadges dark />
      </div>
    </div>
  </div>
</section>
